# OpenAI Configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Or Azure OpenAI
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/az104_trainer

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Environment
ENVIRONMENT=development
DEBUG=true

# Azure lab validation
# Entra app registration (single-tenant) used by the frontend OAuth flow
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
# Comma-separated tenant IDs allowed to validate labs. Falls back to AZURE_TENANT_ID.
AZURE_TENANT_ALLOWLIST=your-tenant-id
# Optional comma-separated subscription ID allowlist
AZURE_SUBSCRIPTION_ALLOWLIST=

# Frontend build (Docker Compose reads these from the host environment)
VITE_AZURE_TENANT_ID=your-tenant-id
VITE_AZURE_CLIENT_ID=your-client-id
VITE_AZURE_REDIRECT_URI=http://localhost:3000
